{
  "name": "local-rarity-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build": "npm run build -w @rarity/contracts && npm run build -w @rarity/game-core && npm run build -w @rarity/server && npm run build -w @rarity/web && node scripts/build-manifest.mjs",
    "test": "vitest run",
    "probe:lan": "node probes/lan/run.mjs",
    "probe:tabs": "node probes/tabs/run.mjs",
    "probe:import": "node probes/import/run.mjs",
    "probe:platform": "node probes/platform/run.mjs",
    "probe:tunnel": "npm run build -w @rarity/contracts && node probes/tunnel/run.mjs",
    "probe:tunnel:test": "npm run probe:tunnel -- --test",
    "setup:tunnel": "node scripts/install-cloudflared.mjs",
    "verify:tunnel": "node scripts/install-cloudflared.mjs --verify",
    "host": "npm run build && npm run build:platform && node apps/server/dist/hosting/launch.js",
    "test:hosting": "npm run build && node scripts/test-local-dashboard.mjs && node scripts/test-managed-hosting.mjs",
    "test:core": "npm run build -w @rarity/contracts && vitest run tests/core",
    "demo:core": "npm run build -w @rarity/contracts && npm run build -w @rarity/game-core && node scripts/demo-core.mjs",
    "test:server": "npm run build && vitest run tests/server",
    "test:game:tunnel": "npm run build && node scripts/test-game-server.mjs",
    "probe:game": "npm run build && node scripts/test-game-server.mjs --manual",
    "measure:import": "npm run build && node scripts/measure-game-import.mjs",
    "test:web": "npm run build -w @rarity/contracts && vitest run tests/web",
    "test:web:layout": "node scripts/test-web-layout.mjs",
    "test:web:tunnel": "npm run build && node scripts/test-browser-game.mjs",
    "probe:web": "npm run build && node scripts/test-browser-game.mjs --manual",
    "prehost": "node scripts/check-runtime.mjs",
    "build:platform": "node scripts/build-platform.mjs",
    "test:portable": "node scripts/test-portable-host.mjs",
    "package:download": "node scripts/package-download.mjs",
    "package:toolchain": "node scripts/package-toolchain.mjs",
    "package:build": "node scripts/package-build.mjs",
    "test:packaging": "node --test tests/packaging/package.check.mjs",
    "test:package:assembly": "node scripts/test-package-assembly.mjs",
    "test:load": "node scripts/load/run.mjs",
    "test:load:tunnel": "node scripts/load/run.mjs --tunnel",
    "test:network:baseline": "node scripts/load/baseline.mjs",
    "test:network:browser": "node scripts/load/browser-baseline.mjs",
    "test:import:capacity": "node scripts/test-import-capacity.mjs",
    "test:accessibility": "node scripts/test-accessibility.mjs",
    "test:release": "node --test tests/release/release.check.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:connector-inventory": "node scripts/release-connector-inventory.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.0",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
